; Hanyang Defense - WP-001 Enemy Flow Prototype
; Engine decision: see docs/DECISIONS.md D-007 / D-008.

config_version=5

[application]

config/name="Hanyang Defense (WP-001)"
config/description="WP-001 enemy flow prototype: 1000 concurrent enemies, three routes, jangseung chokepoints, hwacha saturation fire."
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
